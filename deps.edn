{:paths ["src"]
 :deps {io.github.babashka/libesbuild {:mvn/version "0.28.2-1"}
        babashka/fs {:mvn/version "0.5.34"}
        org.babashka/json {:mvn/version "0.1.6"}}
 :aliases
 {;; Use the shim built by libesbuild/build.sh instead of the released jar.
  :local {:override-deps {io.github.babashka/libesbuild {:local/root "libesbuild"}}}

  ;; babashka.ffi is built into babashka. The JVM run needs it as a dep, and it
  ;; is not released, so it stays out of the pom.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.babashka/ffi
                      {:git/url "https://github.com/babashka/ffi"
                       :git/sha "3917f39ededc25372b78f91b5ef9f409f522eeba"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build}}}
