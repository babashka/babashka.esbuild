{:paths ["script"]
 :deps {io.github.babashka/esbuild {:local/root "."}
        io.github.babashka/libesbuild {:local/root "libesbuild"}}
 :tasks
 {natives {:doc "Builds the shim into libesbuild/resources"
           :requires ([natives])
           :exec-fn natives/build}
  test {:doc "Runs the tests on babashka"
        :depends [natives]
        :extra-paths ["test"]
        :requires ([clojure.test :as t] [babashka.esbuild-test])
        :task (let [{:keys [fail error]} (t/run-tests 'babashka.esbuild-test)]
                (System/exit (if (pos? (+ fail error)) 1 0)))}}}
